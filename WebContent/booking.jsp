<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="model.User,model.Car,dao.CarDAO,java.util.ArrayList" %>
<% User user=(User)session.getAttribute("user"); if(user==null){response.sendRedirect("login.jsp");return;} ArrayList<Car> cars=new CarDAO().getAllCars(); String error=(String)request.getAttribute("error"); String selectedCarId=request.getParameter("carId"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Book a Car - Car Rental Portal</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/css/responsive.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/css/mobile-modern.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/css/final-modern.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/css/reference-modern.css">    <link rel="stylesheet" href="<%=request.getContextPath()%>/css/final-ui-fixes.css">
    <link rel="stylesheet" href="css/modern-all-pages.css">

    <link rel="stylesheet" href="css/crp-modern-v2026.css?v=20260918">

<link rel="stylesheet" href="<%=request.getContextPath()%>/css/portal-unified.css?v=20261011fix1">

<link rel="stylesheet" href="${pageContext.request.contextPath}/css/portal-unified.css?v=20261012-match">

<link rel="stylesheet" href="<%=request.getContextPath()%>/css/modern-design-system.css?v=20261012">

<link rel="stylesheet" href="${pageContext.request.contextPath}/css/portal-visual-repair.css?v=20261017">
</head>
<body class="booking-modern"><div class="booking-card-modern"><div class="flow"><div class="flow-step active"><div class="dot">1</div>Car Details</div><div class="flow-step active"><div class="dot">2</div>Rental Info</div><div class="flow-step"><div class="dot">3</div>Payment</div><div class="flow-step"><div class="dot">4</div>Confirmation</div></div><h1>Book Your Car</h1><div class="booking-layout"><div class="booking-form-modern"><%if(error!=null){%><p class="err"><%=error%></p><%}%><form action="BookingServlet" method="post" oninput="calculate()"><label for="carId">Select Car</label><select id="carId" name="carId" required><option value="">Choose a car</option><%for(Car c:cars){if("Available".equalsIgnoreCase(c.getStatus())){%><option value="<%=c.getCarId()%>" <%=String.valueOf(c.getCarId()).equals(selectedCarId)?"selected":""%> data-price="<%=c.getPricePerDay()%>"><%=c.getCarName()%> - <%=c.getBrand()%> (₹<%=String.format("%.0f",c.getPricePerDay())%>/day)</option><%}}%></select><label for="pickupDate">Pick-up Date</label><input type="date" id="pickupDate" name="pickupDate" required min="<%=java.time.LocalDate.now()%>"><label for="returnDate">Return Date</label><input type="date" id="returnDate" name="returnDate" required><label for="totalAmount">Estimated Total</label><input type="number" id="totalAmount" name="totalAmount" step="0.01" readonly required><button type="submit">Continue to Payment</button></form></div><aside class="booking-summary"><h3>Price Summary</h3><p>Rental amount will be calculated from the selected car and rental period.</p><div class="total-box">₹<span id="summaryTotal">0.00</span></div><p style="color:#667085;font-size:13px">A 20% booking advance is paid first. The remaining amount is paid at delivery.</p></aside></div><p style="text-align:center;margin:22px 0 0"><a href="cars.jsp">Back to Cars</a> · <a href="bookingHistory.jsp">My Bookings</a> · <a href="dashboard.jsp">Dashboard</a></p></div>
<script>function calculate(){const s=document.getElementById('carId'),o=s.options[s.selectedIndex],p=parseFloat(o?.dataset.price||0),a=document.getElementById('pickupDate').value,b=document.getElementById('returnDate').value;if(p&&a&&b){const days=Math.max(1,(new Date(b)-new Date(a))/86400000),t=days*p;document.getElementById('totalAmount').value=t.toFixed(2);document.getElementById('summaryTotal').textContent=t.toFixed(2)}else{document.getElementById('summaryTotal').textContent='0.00'}}document.getElementById('pickupDate').addEventListener('change',()=>{document.getElementById('returnDate').min=document.getElementById('pickupDate').value;calculate()});</script></body></html>
