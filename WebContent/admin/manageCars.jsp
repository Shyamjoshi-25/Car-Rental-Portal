<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="model.Admin,model.Car,dao.CarDAO,java.util.ArrayList" %>
<% if(session.getAttribute("admin")==null || !"ADMIN".equals(session.getAttribute("role"))){response.sendRedirect("../admin-login.jsp");return;} ArrayList<Car> cars=new CarDAO().getAllCars(); String error=(String)request.getAttribute("error"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Cars</title><style>body{font-family:Arial;background:#f4f6f8;margin:0}.top{background:#1f4e79;color:white;padding:20px;text-align:center}.wrap{width:94%;margin:25px auto}.form,.tablebox{background:#fff;padding:20px;border-radius:10px;margin-bottom:22px;overflow:auto}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}.grid input,.grid select{padding:10px;border:1px solid #ccc;border-radius:5px}.btn,button{padding:9px 13px;background:#1f4e79;color:white;border:0;border-radius:5px;text-decoration:none;cursor:pointer}table{width:100%;border-collapse:collapse}th,td{padding:10px;border:1px solid #ddd;text-align:center}.image-field{display:flex;flex-direction:column;gap:8px;grid-column:1/-1;font-size:14px}.car-thumb{width:90px;height:58px;object-fit:cover;border-radius:6px}th{background:#1f4e79;color:white}.danger{background:#dc3545}.msg{color:#187a2f}.err{color:#c62828}</style><link rel="stylesheet" href="../css/ui.css">
<link rel="stylesheet" href="../css/responsive.css">
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/mobile-modern.css">
    <link rel="stylesheet" href="../css/final-modern.css">
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/reference-modern.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/final-ui-fixes.css">
    <link rel="stylesheet" href="../css/modern-all-pages.css">

    <link rel="stylesheet" href="../css/crp-modern-v2026.css?v=20260918">

<link rel="stylesheet" href="<%=request.getContextPath()%>/css/portal-unified.css?v=20261011fix1">

<link rel="stylesheet" href="${pageContext.request.contextPath}/css/portal-unified.css?v=20261012-match">

<link rel="stylesheet" href="<%=request.getContextPath()%>/css/modern-design-system.css?v=20261012">

<link rel="stylesheet" href="${pageContext.request.contextPath}/css/portal-visual-repair.css?v=20261017">
</head><body><div class="top"><h1>Manage Cars</h1></div><div class="wrap"><%if("success".equals(request.getParameter("msg"))){%><p class="msg">Car saved successfully.</p><%}if(error!=null){%><p class="err"><%=error%></p><%}%><div class="form"><h2>Add Car</h2><form action="../CarServlet" method="post" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"><div class="grid"><input name="carName" placeholder="Car name" required><input name="brand" placeholder="Brand"><input name="model" placeholder="Model"><input name="fuelType" placeholder="Fuel type"><input type="number" step="0.01" min="0" name="pricePerDay" placeholder="Price/day" required><select name="status"><option>Available</option><option>Not Available</option></select><label class="image-field">Car Image (JPG, PNG, WEBP; max 5 MB)<input type="file" name="carImage" accept="image/jpeg,image/png,image/webp"></label></div><br><button type="submit">Add Car</button></form></div><div class="tablebox"><h2>Cars in Database</h2><table><tr><th>ID</th><th>Image</th><th>Name</th><th>Brand</th><th>Model</th><th>Fuel</th><th>Price</th><th>Status</th><th>Actions</th></tr><%for(Car c:cars){%><tr><td><%=c.getCarId()%></td><td><img class="car-thumb" src="<%=request.getContextPath()%>/car-image?id=<%=c.getCarId()%>" alt="Car image"><% if(c.getImageData()==null || c.getImageData().length==0){%><small>No image</small><%}%></td><td><%=c.getCarName()%></td><td><%=c.getBrand()%></td><td><%=c.getModel()%></td><td><%=c.getFuelType()%></td><td>₹<%=String.format("%.2f",c.getPricePerDay())%></td><td><%=c.getStatus()%></td><td><form action="../CarServlet" method="post" enctype="multipart/form-data" style="display:inline"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"><input type="hidden" name="action" value="update"><input type="hidden" name="carId" value="<%=c.getCarId()%>"><input type="hidden" name="carName" value="<%=c.getCarName()%>"><input type="hidden" name="brand" value="<%=c.getBrand()%>"><input type="hidden" name="model" value="<%=c.getModel()%>"><input type="hidden" name="fuelType" value="<%=c.getFuelType()%>"><input type="hidden" name="pricePerDay" value="<%=c.getPricePerDay()%>"><input type="file" name="carImage" accept="image/jpeg,image/png,image/webp" title="Choose a new car image" style="max-width:150px"><select name="status"><option <%=c.getStatus().equals("Available")?"selected":""%>>Available</option><option <%=c.getStatus().equals("Not Available")?"selected":""%>>Not Available</option></select><button>Save Status</button></form><form action="../CarServlet" method="post" style="display:inline"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"><input type="hidden" name="carId" value="<%=c.getCarId()%>"><button class="danger" name="action" value="delete" onclick="return confirm('Delete this car?')">Delete</button></form></td></tr><%}%></table></div><p><a href="${pageContext.request.contextPath}/admin/dashboard.jsp">Back to Dashboard</a></p></div></body></html>
