<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="model.Admin,model.Booking,model.Car,model.User,dao.BookingDAO,dao.CarDAO,dao.UserDAO,dao.PaymentDAO,java.util.List" %>
<% if(session.getAttribute("admin")==null || !"ADMIN".equals(session.getAttribute("role"))){response.sendRedirect("../admin-login.jsp");return;} List<Booking> bookings=new BookingDAO().getAllBookings(); CarDAO carDAO=new CarDAO(); UserDAO userDAO=new UserDAO(); PaymentDAO paymentDAO=new PaymentDAO(); List<User> users=userDAO.getAllUsers(); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Bookings</title><style>body{font-family:Arial;background:#f4f6f8;margin:0}.top{background:#1f4e79;color:#fff;padding:20px;text-align:center}.nav{background:#333;text-align:center;padding:13px}.nav a{color:#fff;text-decoration:none;margin:0 12px}.wrap{width:98%;margin:25px auto;overflow:auto}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:10px;border:1px solid #ddd;text-align:center}th{background:#1f4e79;color:#fff}.status{font-weight:bold}.pending{color:#b45309}.booked{color:#176b2d}.delivered{color:#6d28d9}.completed{color:#075985}.cancelled{color:#b91c1c}.btn{padding:7px 10px;border:0;border-radius:4px;color:#fff;cursor:pointer}.deliver{background:#6d28d9}.cancel{background:#dc3545}.note{background:#fff;padding:14px;margin-bottom:18px;border-left:4px solid #1f4e79}</style><link rel="stylesheet" href="../css/ui.css">
<link rel="stylesheet" href="../css/responsive.css">
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/mobile-modern.css">
    <link rel="stylesheet" href="../css/final-modern.css">
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/reference-modern.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/final-ui-fixes.css">
    <link rel="stylesheet" href="../css/modern-all-pages.css">

    <link rel="stylesheet" href="../css/crp-modern-v2026.css?v=20260918">

<link rel="stylesheet" href="<%=request.getContextPath()%>/css/portal-unified.css?v=20261011fix1">

<link rel="stylesheet" href="${pageContext.request.contextPath}/css/portal-unified.css?v=20261012-match">

<link rel="stylesheet" href="<%=request.getContextPath()%>/css/modern-design-system.css?v=20261012">

<link rel="stylesheet" href="${pageContext.request.contextPath}/css/portal-visual-repair.css?v=20261017">
</head><body><div class="top"><h1>Manage Bookings</h1><p>Booking advance → Car delivery → Final payment</p></div><div class="nav"><a href="${pageContext.request.contextPath}/admin/dashboard.jsp">Dashboard</a><a href="${pageContext.request.contextPath}/admin/manageCars.jsp">Cars</a><a href="${pageContext.request.contextPath}/admin/manageBookings.jsp">Bookings</a><a href="${pageContext.request.contextPath}/admin/manageUsers.jsp">Users</a><a href="${pageContext.request.contextPath}/admin/reports.jsp">Reports</a><a href="../logout">Logout</a></div><div class="wrap"><div class="note"><b>Admin process:</b> A customer first pays the 20% booking advance. After the customer arrives, click <b>Mark Delivered</b>. This enables the customer's final payment. The booking becomes Completed after the remaining balance is paid.</div><table><tr><th>ID</th><th>User</th><th>Car</th><th>Pickup</th><th>Return</th><th>Total</th><th>Paid</th><th>Remaining</th><th>Status</th><th>Action</th></tr>
<%for(Booking b:bookings){Car c=carDAO.getCarById(b.getCarId());User u=null;for(User x:users){if(x.getUserId()==b.getUserId()){u=x;break;}}double paid=paymentDAO.getPaidTotal(b.getBookingId());double remaining=Math.max(0,b.getTotalAmount()-paid);String st=b.getBookingStatus();%>
<tr><td><%=b.getBookingId()%></td><td><%=u==null?"Unknown":u.getFullName()%></td><td><%=c==null?"Unknown":c.getCarName()%></td><td><%=b.getPickupDate()%></td><td><%=b.getReturnDate()%></td><td>₹<%=String.format("%.2f",b.getTotalAmount())%></td><td>₹<%=String.format("%.2f",paid)%></td><td>₹<%=String.format("%.2f",remaining)%></td><td class="status <%=st.toLowerCase()%>"><%=st%></td><td>
<%if("Pending".equals(st)){%><span>Awaiting booking payment</span><br><form action="../BookingAdminServlet" method="post" style="display:inline"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"><input type="hidden" name="bookingId" value="<%=b.getBookingId()%>"><button class="btn cancel" name="action" value="cancel">Cancel</button></form>
<%}else if("Booked".equals(st)){%><form action="../BookingAdminServlet" method="post"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"><input type="hidden" name="bookingId" value="<%=b.getBookingId()%>"><button class="btn deliver" name="action" value="deliver">Mark Delivered</button></form><form action="../BookingAdminServlet" method="post"><input type="hidden" name="csrfToken" value="<%=session.getAttribute("csrfToken")%>"><input type="hidden" name="bookingId" value="<%=b.getBookingId()%>"><button class="btn cancel" name="action" value="cancel">Cancel</button></form>
<%}else if("Delivered".equals(st)){%><span>Waiting for final payment</span><%}else if("Completed".equals(st)){%><span>Fully Paid</span><%}else{%>-<%}%></td></tr><%}%></table><p><a href="${pageContext.request.contextPath}/admin/dashboard.jsp">Back to Dashboard</a></p></div></body></html>
