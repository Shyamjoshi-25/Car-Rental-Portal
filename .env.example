# Copy this file to .env for local/Docker use.
# Never commit .env to GitHub.
POSTGRES_DB=car_rental
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=car_rental
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# HTTPS self-signed demo certificate password. Use a strong value in deployment.
HTTPS_KEYSTORE_PASSWORD=CHANGE_THIS_KEYSTORE_PASSWORD
